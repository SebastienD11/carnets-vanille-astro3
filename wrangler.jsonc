{
  // Nothing deploys from this file until the Cloudflare project is switched
  // from Pages to Workers. See docs/REDESIGN-2027-REPORT.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carnets-vanille",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Pages are static files. Only these paths wake the Worker.
    "run_worker_first": ["/api/*", "/preview/*"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
