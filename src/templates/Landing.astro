---
// Destination pages (Saint-Malo, Québec, Le monde), driven by the ACF sections in WordPress.
import { Image } from 'astro:assets'
import EbookCard from '../components/EbookCard.astro'
import PostCard from '../components/PostCard.astro'
import { replaceUrls } from '../lib/content'
import { getSite } from '../lib/site'
import { getPostById, type Page, type PageSection } from '../lib/wordpress'

type Props = { node: Page }

const { node: page } = Astro.props
const lang = Astro.currentLocale as string
const site = getSite(lang)
const hero = site.landingHero[page.slug]
const sections: PageSection[] = page.acf.sections || []

const anchor = (index: number) => `section-${index + 1}`
const sectionPosts = await Promise.all(
  sections.map(async (section) =>
    (await Promise.all((section.section_articles || []).map(({ ID }) => getPostById(ID, lang)))).flatMap(
      (post) => post ?? []
    )
  )
)
---

<link slot="head" rel="stylesheet" href="/icons/glace-icons.css" />

<main>
  <div class="cv-container grid gap-5 py-6 lg:grid-cols-2 lg:items-center lg:gap-10 lg:py-12">
    <div class="flex flex-col gap-4">
      <h1 class="cv-h1">{page.acf.introduction_title}</h1>
      {page.acf.introduction_intro && <div class="cv-prose max-w-[58ch]" set:html={replaceUrls(page.acf.introduction_intro)} />}
      {
        sections.length > 1 && (
          <ul class="flex flex-wrap gap-2">
            {sections.map((section, index) => (
              <li>
                <a href={`#${anchor(index)}`} class="cv-btn cv-btn-soft !min-h-10 rounded-full !px-4 !py-2 text-sm">{section.section_title}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      hero && (
        <Image
          src={hero.image}
          alt={hero.alt}
          inferSize
          widths={[640, 1100]}
          sizes="(min-width: 1024px) 600px, 100vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
          class="order-first aspect-[3/2] w-full rounded-lg object-cover lg:order-last"
        />
      )
    }
  </div>

  <div class="cv-container flex flex-col gap-12 pb-12 lg:gap-16 lg:pb-16">
    {
      sections.map((section, index) => (
        <section id={anchor(index)} class="flex scroll-mt-24 flex-col gap-5">
          <h2 class="cv-h2 flex items-center gap-3">
            {section.section_icon && <i class={`icon-${section.section_icon} text-3xl font-normal`} aria-hidden="true" />}
            {section.section_title}
          </h2>
          {(section.section_banner || section.section_intro) && (
            <div class="grid gap-5 md:grid-cols-2 md:items-center">
              {section.section_banner && section.section_banner_link && (
                <a
                  href={replaceUrls(section.section_banner_link.url)}
                  target={section.section_banner_link.target || undefined}
                  rel={section.section_banner_link.target === '_blank' ? 'noopener' : undefined}
                  class="group relative flex min-h-44 items-end overflow-hidden rounded-lg bg-ink bg-cover bg-center p-4 md:min-h-56"
                  style={`background-image:linear-gradient(to top, rgb(0 0 0 / .65), transparent 60%),url(${section.section_banner_image?.sizes?.['medium-1x']});`}
                >
                  <span class="font-display text-xl font-extrabold tracking-tight text-white group-hover:underline" set:html={section.section_banner_text} />
                </a>
              )}
              {section.section_intro && <div class="cv-prose" set:html={replaceUrls(section.section_intro)} />}
            </div>
          )}
          {sectionPosts[index].length > 0 && (
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {sectionPosts[index].map((post) => (
                <li><PostCard post={post} /></li>
              ))}
            </ul>
          )}
          {section.section_read_more_label && section.section_read_more_link && (
            <div>
              <a
                href={replaceUrls(section.section_read_more_link.url)}
                target={section.section_read_more_link.target || undefined}
                rel={section.section_read_more_link.target === '_blank' ? 'noopener' : undefined}
                class="cv-btn cv-btn-dark w-full sm:w-auto"
              >
                {section.section_read_more_label}
              </a>
            </div>
          )}
        </section>
      ))
    }
    {page.acf.banner_ebook && <EbookCard />}
  </div>
</main>
