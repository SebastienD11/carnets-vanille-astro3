---
import { decode } from 'html-entities'
import ArticleBody from '../components/ArticleBody.astro'
import { processContent } from '../lib/content'
import type { Page } from '../lib/wordpress'

type Props = { node: Page }

const { node: page } = Astro.props
const { segments } = processContent(page.content.rendered)
---

<main class="cv-container py-8 lg:py-14">
  <article class="mx-auto max-w-[var(--container-reading)]">
    <h1 class="mb-6 text-4xl tracking-[-0.03em] lg:text-5xl">{decode(page.title.rendered)}</h1>
    <ArticleBody segments={segments} />
  </article>
</main>
