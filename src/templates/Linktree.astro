---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../i18n/ui'
import { replaceUrls } from '../lib/content'
import { getSite } from '../lib/site'
import { getEbookPrice, type Page } from '../lib/wordpress'

type Props = { node: Page }

const { node: page } = Astro.props
const lang = Astro.currentLocale as string
const site = getSite(lang)
const t = useTranslations(lang as 'fr')
const price = site.ebook ? await getEbookPrice() : null
const sections = page.acf.sections || []
---

<link slot="head" rel="stylesheet" href="/icons/glace-icons.css" />

<main class="mx-auto flex w-full max-w-[480px] flex-col gap-5 px-4 py-8">
  <a href={getRelativeLocaleUrl(lang, '/')} class="mx-auto block" aria-label="Carnets Vanille">
    <img src="/logos/footer-on-light.svg" width="373" height="163" alt="Carnets Vanille" class="h-auto w-[220px] dark:hidden" />
    <img src="/logos/footer-on-dark.svg" width="373" height="163" alt="Carnets Vanille" class="hidden h-auto w-[220px] dark:block" />
  </a>
  {
    sections.map((section: any) => {
      if (section.type === 'ebook') {
        return (
          site.ebook && (
            <a href={site.ebook.href} class="flex min-h-14 items-center rounded-md bg-vanille px-4 py-3 font-extrabold text-ink">
              {t('nav.ebook')}{price && ` · ${price}`}
            </a>
          )
        )
      }
      return (
        <section class="flex flex-col gap-2">
          {section.titre && <h2 class="font-sans text-sm font-bold tracking-normal text-muted">{section.titre}</h2>}
          {(section.links || []).map((link: any) => (
            <a
              href={replaceUrls(link.link_url.url)}
              target={link.link_url.target || undefined}
              class="flex min-h-14 items-center gap-3 rounded-md bg-sunken px-4 py-3 font-extrabold hover:bg-line"
            >
              {link.link_icon && <i class={`icon-${link.link_icon} font-normal`} aria-hidden="true" />}
              {link.link_label}
            </a>
          ))}
        </section>
      )
    })
  }
</main>
