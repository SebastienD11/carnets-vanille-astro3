---
import { useTranslations } from '../i18n/ui'

const t = useTranslations(Astro.currentLocale as 'fr')
---

<div class="flex h-full flex-col justify-center gap-3 rounded-lg bg-sunken p-5">
  <h3 class="text-xl leading-tight lg:text-[22px]">{t('newsletter.card.title')}</h3>
  <p class="text-[15px] leading-snug text-muted">{t('newsletter.card.subtitle')}</p>
  <div>
    <button type="button" data-dialog-open="cv-newsletter" class="cv-btn cv-btn-dark w-full">
      {t('newsletter.card.label')}
    </button>
  </div>
</div>
