---
import type { Alternate } from '../lib/content'
import type { Yoast } from '../lib/wordpress'

type Props = { seo: { yoast: Yoast; alternates: Alternate[] } }

const { seo } = Astro.props
const { yoast, alternates } = seo

const robots = Object.values(yoast.robots ?? {}).join(', ')
const twitterMisc = Object.entries(yoast.twitter_misc ?? {})

// Yoast's canonical is the first page. The snapshot is shared between pages, so this must not write to it.
const page = Number(Astro.url.pathname.match(/\/page\/(\d+)/)?.[1] ?? 1)
const canonical = page > 1 ? `${yoast.canonical}page/${page}/` : yoast.canonical
const image = yoast.og_image?.[0]
---

<title>{yoast.title}</title>
<meta name="robots" content={robots} />
{/* Translations exist for a listing's first page only, so page 2+ must not claim one. */}
{page === 1 && alternates?.map((alternate) => <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />)}
{yoast.description && <meta name="description" content={yoast.description} />}
{canonical && <link rel="canonical" href={canonical} />}
{yoast.og_locale && <meta property="og:locale" content={yoast.og_locale} />}
{yoast.og_type && <meta property="og:type" content={yoast.og_type} />}
{yoast.og_title && <meta property="og:title" content={yoast.og_title} />}
{yoast.og_description && <meta property="og:description" content={yoast.og_description} />}
{yoast.og_url && <meta property="og:url" content={yoast.og_url} />}
{yoast.og_site_name && <meta property="og:site_name" content={yoast.og_site_name} />}
{yoast.article_publisher && <meta property="article:publisher" content={yoast.article_publisher} />}
{yoast.article_published_time && <meta property="article:published_time" content={yoast.article_published_time} />}
{yoast.article_modified_time && <meta property="article:modified_time" content={yoast.article_modified_time} />}
{
  image && (
    <>
      <meta property="og:image" content={image.url} />
      <meta property="og:image:width" content={String(image.width)} />
      <meta property="og:image:height" content={String(image.height)} />
      <meta property="og:image:type" content={image.type} />
    </>
  )
}
{yoast.author && <meta name="author" content={yoast.author} />}
{yoast.twitter_card && <meta name="twitter:card" content={yoast.twitter_card} />}
{yoast.twitter_creator && <meta name="twitter:creator" content={yoast.twitter_creator} />}
{yoast.twitter_site && <meta name="twitter:site" content={yoast.twitter_site} />}
{
  twitterMisc.map(([key, value], index) => (
    <>
      <meta name={`twitter:label${index + 1}`} content={key} />
      <meta name={`twitter:data${index + 1}`} content={String(value)} />
    </>
  ))
}
{yoast.schema && <script type="application/ld+json" set:html={JSON.stringify(yoast.schema)} />}
