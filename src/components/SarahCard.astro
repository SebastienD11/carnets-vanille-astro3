---
import { Image } from 'astro:assets'
import portrait from '../images/sarah-carnets-vanille.png'
import { AUTHOR_PHOTO_ALT, getSite } from '../lib/site'

const site = getSite(Astro.currentLocale as string)
---

<aside class="flex flex-col gap-3 rounded-lg bg-vanille p-5 text-ink sm:flex-row sm:items-center sm:gap-5">
  <div class="flex items-center gap-4 sm:contents">
    <Image
      src={portrait}
      alt={AUTHOR_PHOTO_ALT}
      width={80}
      height={80}
      densities={[1, 2]}
      loading="lazy"
      class="h-16 w-16 shrink-0 rounded-full object-cover sm:h-20 sm:w-20"
    />
    <h2 class="text-2xl sm:hidden">{site.sarah.title}</h2>
  </div>
  <div class="flex flex-col gap-1">
    <h2 class="hidden text-2xl sm:block">{site.sarah.title}</h2>
    <p class="text-[15px] leading-snug">{site.sarah.text}</p>
    <a href={site.sarah.link.href} target="_blank" rel="noopener" class="mt-1 text-sm font-extrabold underline underline-offset-3">
      {site.sarah.link.label}
    </a>
  </div>
</aside>
