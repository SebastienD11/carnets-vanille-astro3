---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../../i18n/ui'
import Icon from '../Icon.astro'
import SarahCard from '../SarahCard.astro'

type Props = { title: string; text: string }

const { title, text } = Astro.props
const lang = Astro.currentLocale as string
const t = useTranslations(lang as 'fr')
---

<dialog id="cv-thank-you" class="cv-dialog cv-dialog-modal" aria-label={title}>
  <div class="flex flex-col gap-5 p-5 lg:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-3xl">{title}</h2>
      <button type="button" data-dialog-close class="-mt-2 -mr-2 flex h-11 w-11 shrink-0 items-center justify-center" aria-label={t('nav.close')}>
        <Icon name="close" />
      </button>
    </div>
    <p class="[&_a]:underline" set:html={text} />
    <SarahCard />
    <a href={getRelativeLocaleUrl(lang, '/')} class="cv-text-link text-sm">{t('product.common.back')}</a>
  </div>
</dialog>

<script>
  // Stripe sends the buyer back with ?session_id=...
  if (new URLSearchParams(window.location.search).get('session_id')) {
    ;(window as any).plausible?.('ebook-page-with-checkout-session-id')
    document.querySelector<HTMLDialogElement>('#cv-thank-you')?.showModal()
  }
</script>
