---
type Props = {
  id: string
  name: string
  label: string
  type?: 'text' | 'email' | 'textarea'
  required?: boolean
  autocomplete?: string
}

const { id, name, label, type = 'text', required, autocomplete } = Astro.props
---

<div>
  <label for={id} class="cv-label">{label}</label>
  {
    type === 'textarea' ? (
      <textarea id={id} name={name} required={required} rows="5" class="cv-input" />
    ) : (
      <input id={id} name={name} type={type} required={required} autocomplete={autocomplete} class="cv-input" />
    )
  }
</div>
