---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../i18n/ui'

type Props = { total: number; perPage: number; currentPage: number; baseUrl: string }

const { total, perPage, currentPage, baseUrl } = Astro.props
const lang = Astro.currentLocale as string
const t = useTranslations(lang as 'fr')
const totalPages = Math.ceil(total / perPage)
const urlOf = (page: number) =>
  getRelativeLocaleUrl(lang, page === 1 ? baseUrl || '/' : `${baseUrl}/page/${page}`)
---

{
  totalPages > 1 && (
    <nav aria-label={t('pagination.label')}>
      <ul class="flex flex-wrap items-center justify-center gap-2">
        {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
          <li>
            {page === currentPage ? (
              <span
                aria-current="page"
                class="flex h-11 w-11 items-center justify-center rounded-md bg-ink font-extrabold text-white dark:bg-vanille dark:text-ink"
              >
                {page}
              </span>
            ) : (
              <a
                href={urlOf(page)}
                class="flex h-11 w-11 items-center justify-center rounded-md bg-sunken font-extrabold hover:bg-line"
              >
                {page}
              </a>
            )}
          </li>
        ))}
        {currentPage < totalPages && (
          <li>
            <a href={urlOf(currentPage + 1)} rel="next" class="flex h-11 items-center rounded-md border-2 border-body px-4 font-extrabold">
              {t('pagination.next')}
            </a>
          </li>
        )}
      </ul>
    </nav>
  )
}
