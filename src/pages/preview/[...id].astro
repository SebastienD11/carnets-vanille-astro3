---
// Live preview of the latest revision of a post, rendered on the Worker.
export const prerender = false

import { decode } from 'html-entities'
import ArticleBody from '../../components/ArticleBody.astro'
import Layout from '../../layouts/Layout.astro'
import { processContent } from '../../lib/content'
import { wpGet } from '../../lib/wordpress/client'

const id = parseInt(Astro.params.id ?? '', 10)
if (Number.isNaN(id)) return new Response(null, { status: 404 })

const revisions = await wpGet<{ id: number }[]>(`/posts/${id}/revisions`, { auth: true })
const revision = await wpGet<any>(`/posts/${id}/revisions/${revisions[0].id}`, { auth: true })
const { segments } = processContent(revision.content.rendered)
---

<Layout bare>
  <main class="cv-container py-8">
    <article class="mx-auto max-w-[var(--container-reading)]">
      <p class="mb-2 inline-block rounded-sm bg-vanille px-2 py-1 text-sm font-extrabold text-ink">Preview</p>
      <h1 class="mb-6 text-4xl">{decode(revision.title.rendered)}</h1>
      <ArticleBody segments={segments} banners={false} />
    </article>
  </main>
</Layout>
